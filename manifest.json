{
  "manifest_version": 3,
  "name": "CS2 Profile Checker",
  "version": "1.0.1",
  "description": "Quickly check CS2 player profiles, trackers, sync notes, custom tags, GSI live match, and i18n.",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardRead",
    "storage"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
