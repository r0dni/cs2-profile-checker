{
  "manifest_version": 3,
  "name": "CS2 Profile Checker",
  "version": "0.2.2",
  "description": "Quickly check CS2 player profiles, trackers, sync notes, custom tags, auto-open, and i18n.",
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardRead",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
